{
  "manifest_version": 3,
  "name": "Axiom Translator",
  "version": "1.3.0",
  "description": "Автоматический перевод твитов на русский язык для axiom.trade с сохранением крипто-сленга.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://axiom.trade/*",
    "https://trade.padre.gg/*",
    "https://*.padre.gg/*",
    "https://translate.googleapis.com/*",
    "https://www.google.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api.fxtwitter.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://mozhi.pussthecat.org/*",
    "https://mozhi.r4fo.com/*",
    "https://mzh.dc09.xyz/*",
    "https://mozhi.adminforge.de/*",
    "https://mozhi.bloat.cat/*",
    "https://mozhi.ducks.party/*",
    "https://simplytranslate.org/*",
    "https://translate.plausibility.cloud/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://axiom.trade/*",
        "https://trade.padre.gg/*",
        "https://*.padre.gg/*"
      ],
      "js": [
        "popup/errorHandler.js",
        "axiom/constants.js",
        "axiom/utils.js",
        "axiom/cache.js",
        "axiom/diagnostics.js",
        "axiom/preprocessor.js",
        "axiom/rate-limiter.js",
        "axiom/queue.js",
        "axiom/dom-finder.js",
        "axiom/pre-cacher.js",
        "axiom/translator.js",
        "axiom/observer.js",
        "axiom/ui.js",
        "axiom/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
